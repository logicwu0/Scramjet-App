# Local mock test only. Node.js >=22.23.4.
CAS_LOCAL_TEST=1
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
CAS_BASE_URL=http://127.0.0.1:9080/cas/
CAS_SESSION_SECONDS=3600
CAS_ONLINE_CHECK=0
# Enable CAS_ONLINE_CHECK=1 only when the school's online detection endpoint is available.
# Real school integration: CAS_LOCAL_TEST=0, APP_ORIGIN=https://your-approved-domain
# CAS_BASE_URL=https://cas.ncu.edu.cn:8443/cas/
# Security events only; unset file means service stdout.
# SECURITY_LOG_FILE=/var/log/webvpn/security.jsonl
# Enable only behind loopback Nginx overriding X-Real-IP.
SECURITY_TRUST_LOOPBACK_PROXY=0

# Optional local-only connection log; never collected by security Syslog rules.
# ACCESS_LOG_FILE=/var/log/webvpn/access.jsonl
