{
	"name": "scramjet-demo",
	"version": "2.0.0",
	"description": "The demo application for Scramjet, a high-performance web proxy.",
	"type": "module",
	"engines": {
		"npm": ">=7.0.0",
		"node": ">=22.23.4"
	},
	"scripts": {
		"test:cas": "node --test test/cas.test.js",
		"test:cas:live": "node --test test/cas.live.test.js",
		"dev:cas": "node --env-file=.env.ncu.example src/index.js",
		"mock:cas": "node scripts/mock-cas.mjs",
		"start": "node src/index.js",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"keywords": [
		"proxy"
	],
	"author": "Mercury Workshop",
	"license": "GNU AFFERO",
	"dependencies": {
		"saxes": "6.0.0",
		"@fastify/static": "^8.2.0",
		"@mercuryworkshop/bare-mux": "^2.1.7",
		"@mercuryworkshop/epoxy-transport": "^2.1.28",
		"@mercuryworkshop/libcurl-transport": "github:logicwu0/libcurl-transport",
		"@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/latest/mercuryworkshop-scramjet-2.0.0-alpha.tgz",
		"@mercuryworkshop/wisp-js": "^0.4.1",
		"fastify": "^5.4.0",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"eslint": "^9.13.0",
		"prettier": "^3.3.3"
	},
	"packageManager": "pnpm@10.18.3"
}
